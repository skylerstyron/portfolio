---
import GnarCrew from "../assets/GnarCrew.png";
import Nascient from "../assets/Nascient.png";
import Amerch from "../assets/Amerch.png";
import Swiss from "../assets/Swiss.png";
import WOW from "../assets/WOW.png";
import CAA from "../assets/ClassicAutoAir.png";
---

<section id="projects">
  <h2 class="heading-1">Check out some of my previous & personal work</h2>
  <ul class="projects">
    <li class="card">
      <a href="https://gnarcrew.com" target="_blank">
        <figure class="card-picture">
          <img src={GnarCrew.src} alt="Gnar Crew Project" />
        </figure>
      </a>
      <h3 class="heading-3"><a href="https://gnarcrew.com">Gnar Crew (My brand)</a></h3>
      <ul class="card-skills">
        <li class="card-tag">Custom Shopify Theme</li>
        <li class="card-tag">Branding</li>
        <li class="card-tag">Photo & Video</li>
      </ul>
    </li>
    <li class="card">
      <a href="https://nascient.io/" target="_blank">
        <figure class="card-picture">
          <img src={Nascient.src} alt="Nascient Networks" />
        </figure>
      </a>
      <h3 class="heading-3">
        <a href="https://nascient.io/">Nascient Networks</a>
      </h3>
      <ul class="card-skills">
        <li class="card-tag">Custom WordPress Theme</li>
        <li class="card-tag">ACF</li>
        <li class="card-tag">PHP</li>
        <li class="card-tag">Bootstrap</li>
      </ul>
    </li>
    <li class="card">
      <a href="https://amerch.com/" target="_blank">
        <figure class="card-picture">
          <img src={Amerch.src} alt="Anderson Merchandisers" />
        </figure>
      </a>
      <h3 class="heading-3">
        <a href="https://amerch.com/">Anderson Merchandisers</a>
      </h3>
      <ul class="card-skills">
        <li class="card-tag">Custom WordPress Theme</li>
        <li class="card-tag">ACF</li>
        <li class="card-tag">PHP</li>
        <li class="card-tag">Bootstrap</li>
      </ul>
    </li>
    <li class="card">
      <a href="https://www.swissamericancdmo.com/" target="_blank">
        <figure class="card-picture">
          <img src={Swiss.src} alt="Swiss American CDMO" />
        </figure>
      </a>
      <h3 class="heading-3"><a href="https://www.swissamericancdmo.com/">Swiss American CDMO</a></h3>
      <ul class="card-skills">
        <li class="card-tag">Custom WordPress Theme</li>
        <li class="card-tag">ACF</li>
        <li class="card-tag">PHP</li>
        <li class="card-tag">Bootstrap</li>
      </ul>
    </li>
    <li class="card">
      <a href="https://www.classicautoair.com/" target="_blank">
        <figure class="card-picture">
          <img src={CAA.src} alt="Classic Auto Air" />
        </figure>
      </a>
      <h3 class="heading-3"><a href="https://www.classicautoair.com/">Classic Auto Air</a></h3>
      <ul class="card-skills">
        <li class="card-tag">Custom WordPress Theme</li>
        <li class="card-tag">Custom Plugins</li>
        <li class="card-tag">PHP</li>
      </ul>
    </li>
    <li class="card">
      <a href="https://wowme.netlify.app/" target="_blank">
        <figure class="card-picture">
          <img src={WOW.src} alt="Wow me" />
        </figure>
      </a>
      <h3 class="heading-3"><a href="https://wowme.netlify.app/">WOW ME (for fun)</a></h3>
      <ul class="card-skills">
        <li class="card-tag">Owen Wilson API</li>
        <li class="card-tag">HTML</li>
        <li class="card-tag">CSS</li>
        <li class="card-tag">JavaScript</li>
